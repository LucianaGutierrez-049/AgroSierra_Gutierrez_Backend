{
  "info": {
    "name": "AgroSierra Gutierrez · API y seguridad",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/api/v1"
    },
    {
      "key": "tokenAlterado",
      "value": "token-invalido"
    }
